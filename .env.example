DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=TU_PASSWORD_SECRETA
DB_NAME=mynted_db

JWT_SECRET=reemplaza-esto-con-un-secret-aleatorio-largo
JWT_EXPIRES_IN_SECONDS=86400

//correr este comando para generar un secret aleatorio: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRES_IN_MINUTES=60

// SMTP opcional: si se omite, los enlaces de recuperación se imprimen en consola
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mynted.com